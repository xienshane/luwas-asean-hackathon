# LUWAS environment variables — catalog of every var across deploy targets.
# Copy the block you need into that app's local env file (never commit real values):
#   web/.env.local       Next.js app (Vercel)
#   ai-services/.env     FastAPI services (Hugging Face Space)

# --- web (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
# Phase 4.7 live environmental signal (Open-Meteo — free, NO key). All optional; defaults shown.
# The signal samples a fixed set of Cebu-region points (north/central/south) in code and
# takes the worst-case wind, so there is no single lat/lng to configure here.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
LIVE_CONDITIONS_TTL_SECONDS=600    # in-memory cache TTL (seconds)
# server-only (route handlers — never expose with NEXT_PUBLIC):
# service-role inserts for the SMS webhook + the pipeline orchestrator, plus the webhook secret
SUPABASE_SERVICE_ROLE_KEY=
SMS_WEBHOOK_SECRET=
# demo-only SMS simulator (app/api/sms/mock): leave unset/false in production (route 404s).
ENABLE_SMS_MOCK=

# --- ai-services (Hugging Face Space) ---
SUPABASE_SERVICE_ROLE_KEY=
SEA_LION_API_KEY=
GEMINI_API_KEY=

# --- shared: database + scoping (supabase migrations, data-pipeline) ---
DATABASE_URL=
CEBU_REGION_BBOX=
